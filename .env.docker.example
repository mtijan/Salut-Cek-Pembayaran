# Copy this file to .env for local Docker Compose use. Do not commit .env.
APP_ENV=production
HOST_PORT=8000
WEB_CONCURRENCY=1
LOOKUP_HASH_SECRET=ganti-dengan-secret-random-minimal-32-karakter
ADMIN_BOOTSTRAP_EMAIL=admin@example.test
ADMIN_BOOTSTRAP_PASSWORD=ganti-dengan-password-kuat-minimal-12-karakter
# Required for immutable image/runtime identity; use the approved 7-40 character Git revision.
RELEASE_ID=
# Leave false for direct Docker access. Set true only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_MAX_BUCKETS=10000
