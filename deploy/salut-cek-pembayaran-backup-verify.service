[Unit]
Description=Verify latest SQLite backup Salut Cek Pembayaran

[Service]
Type=oneshot
User=salut
Group=salut
UMask=0077
WorkingDirectory=/opt/salut-cek-pembayaran
ExecStart=/usr/bin/python3 /opt/salut-cek-pembayaran/Backend/verify_backup.py --directory /var/backups/salut-cek-pembayaran
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/var/backups/salut-cek-pembayaran
