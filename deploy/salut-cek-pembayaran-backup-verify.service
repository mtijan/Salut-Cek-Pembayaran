[Unit]
Description=Verify latest SQLite backup Salut Cek Pembayaran

[Service]
Type=oneshot
User=salut
Group=salut
UMask=0077
WorkingDirectory=/opt/salut-cek-pembayaran
ExecStart=/opt/salut-cek-pembayaran/.venv/bin/python -m Backend.verify_backup --directory /var/backups/salut-cek-pembayaran
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/var/backups/salut-cek-pembayaran
