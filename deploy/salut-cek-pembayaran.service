[Unit]
Description=Salut Cek Pembayaran
After=network.target

[Service]
Type=simple
User=salut
Group=salut
WorkingDirectory=/opt/salut-cek-pembayaran
EnvironmentFile=/etc/salut-cek-pembayaran.env
ExecStart=/opt/salut-cek-pembayaran/.venv/bin/uvicorn Backend.app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/salut-cek-pembayaran /var/backups/salut-cek-pembayaran

[Install]
WantedBy=multi-user.target
