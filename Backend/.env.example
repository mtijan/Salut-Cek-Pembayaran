APP_ENV=production
PORT=8000
WEB_CONCURRENCY=1
RELEASE_ID=auto
DATABASE_URL=/var/lib/salut-cek-pembayaran/salut.sqlite
IMPORT_DIR=/var/lib/salut-cek-pembayaran/imports
LOOKUP_HASH_SECRET=ganti-dengan-secret-random-panjang
ADMIN_BOOTSTRAP_EMAIL=admin@example.test
ADMIN_BOOTSTRAP_PASSWORD=ganti-dengan-password-kuat
# Set true only when the application is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
DEFAULT_PROGRAM_STUDY=S1 Ilmu Hukum
DEFAULT_PAYMENT_PERIOD_LABEL=Semester Ganjil 2026
# Retensi operasional; audit log sengaja tidak dipangkas otomatis.
SESSION_RETENTION_DAYS=7
LOOKUP_LOG_RETENTION_DAYS=90
IMPORT_ISSUE_RETENTION_DAYS=180
